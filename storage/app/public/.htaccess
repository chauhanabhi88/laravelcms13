# Public uploads (served through the public/storage link) are data, never code (plan M21 S6).
# Nginx equivalent: location ^~ /storage/ { location ~ \.(php|phtml|phar)$ { deny all; } }
<IfModule mod_authz_core.c>
    <FilesMatch "\.(php[0-9]?|phtml|phar|pht|phps|cgi|pl|py|sh)$">
        Require all denied
    </FilesMatch>
</IfModule>
